{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "express", "cors", "pg"]
  },
  "include": ["src/**/*", "prisma/**/*", "prisma.config.ts"]
}
